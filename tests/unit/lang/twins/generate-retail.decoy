decoy 1

pipeline {
  seed 42

  generate customers rows 1000 to csv("./customers.csv") {
    customer_id  = sequence(10000, step: 1)
    first_name   = faker(first_name)
    last_name    = faker(last_name)
    email        = faker(email)
    city         = faker(city)
    loyalty_tier = categorical({None: 0.6, Silver: 0.3, Gold: 0.1})
  }

  generate orders rows 3000 to csv("./orders.csv") {
    order_id    = sequence(1, step: 1)
    customer_id <- customers.customer_id
    ordered_on  = faker(date_this_year)
    status      = categorical({New: 0.1, Paid: 0.3, Shipped: 0.5, Returned: 0.1})
  }

  generate order_lines rows 8000 to csv("./order_lines.csv") {
    line_id          = sequence(1, step: 1)
    order_id         <- orders.order_id
    product_category = categorical({Apparel: 0.25, Home: 0.2, Electronics: 0.15, Beauty: 0.15, Grocery: 0.25})
    quantity         = faker(random_int, faker_kwargs: {min: 1, max: 5})
    unit_price       = distribution(uniform, low: 3, high: 400, output_type: "decimal(2)")
  }
}

# Decoy CLI launch pins (B-2, §CLI-LAUNCH).
#
# This is the ONE place the launch versions live. Everything that assembles a
# bundle or generates the version document sources this file; nothing hard-codes
# a launch version. A sentry test (tests/unit/test_pin_single_source.py) fails if
# a second literal launch-engine version appears anywhere else in the repo.
#
# Shell tools source it directly; Python tools read it with
# packaging.bundle.assemble.read_pins() (a tiny KEY=VALUE parser, no shell).
#
# ============================================================================
# >>> ORCHESTRATOR: SWAP DECOY_LAUNCH_ENGINE_VERSION WHEN D-4 LANDS. <<<
# ============================================================================
# D-4 freezes the DP-certified launch engine (and its matched CLI) as the
# capture target. Until then this holds the CURRENT engine build so every part
# of the packaging is built and testable now; it is NOT a launch decision and
# must not be read as one. Change this one value, rebuild the bundles, and the
# whole pipeline repins. Do not guess a launch version: the orchestrator sets
# the real one here when D-4 cuts it.
DECOY_LAUNCH_ENGINE_VERSION=0.12.0

# The matched native companion ABI tag the bundle's wheel must report
# (decoy-engine/docs/native/supported-matrix.md). The assembler asserts the
# bundled companion's abi_version() equals this before it seals a bundle.
DECOY_LAUNCH_NATIVE_ABI=decoy-native-abi-2

# The embedded standalone CPython, pinned to one minor in the engine's supported
# range (3.10, 3.11, 3.12). python-build-standalone release tag + CPython version.
# Bundling CPython avoids the system-Python version problem entirely.
DECOY_LAUNCH_PYTHON_VERSION=3.12.7
DECOY_LAUNCH_PYTHON_BUILD=20241016

# The CLI version this bundle set ships. The CLI and engine version independently
# (docs/release/versioning.md); this is the decoy-cli dist version, cut by the
# orchestrator at release. Placeholder = the current unreleased line.
DECOY_LAUNCH_CLI_VERSION=0.1.0
